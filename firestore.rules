rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own user document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        // Prevent unbounded completedDays growth from retries or repeated marking.
        && (!request.resource.data.keys().hasAny(['progress'])
          || (request.resource.data.progress is map
            && (!request.resource.data.progress.keys().hasAny(['completedDays'])
              || (request.resource.data.progress.completedDays is list
                && request.resource.data.progress.completedDays.size() <= 400))));

      // Reading plan subcollection
      match /readingPlan/{dayId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
